[Unit]
Description=Cloudflare WARP SOCKS5 proxy for Telegram
After=network-online.target warp-svc.service
Wants=network-online.target
Before=bot.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/usr/bin/warp-cli --accept-tos mode proxy
ExecStart=/bin/bash -c 'warp-cli --accept-tos connect && exec sleep infinity'
ExecStop=/usr/bin/warp-cli --accept-tos disconnect
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
